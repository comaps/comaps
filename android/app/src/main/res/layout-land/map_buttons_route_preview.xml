<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/route_preview_buttons_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/nav_route_preview_cancel"
        style="@style/MwmWidget.M3.FAB.MapButton"
        android:layout_gravity="center"
        android:layout_marginRight="@dimen/margin_base_plus"
        android:contentDescription="@string/route_preview_cancel"
        android:tint="?iconTint"
        app:shapeAppearance="@style/Widget.MaterialComponents.FloatingActionButton"
        app:srcCompat="@drawable/ic_close" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/nav_route_preview_prev"
        style="@style/MwmWidget.M3.FAB.MapButton"
        android:contentDescription="@string/route_preview_previous_turn"
        android:tint="?iconTint"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MapButton.RoutePreview.Previous"
        app:srcCompat="@drawable/ic_arrow_back" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/nav_route_preview_text"
        android:layout_width="100dp"
        android:layout_height="@dimen/map_button_size"
        android:layout_marginStart="@dimen/margin_eighth"
        android:layout_marginEnd="@dimen/margin_eighth"
        android:background="@drawable/bg_route_preview_label"
        android:gravity="center"
        android:textSize="@dimen/text_size_body_1"
        android:tint="?iconTint"
        tools:text="3 of 18" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/nav_route_preview_next"
        style="@style/MwmWidget.M3.FAB.MapButton"
        android:contentDescription="@string/route_preview_next_turn"
        android:tint="?iconTint"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MapButton.RoutePreview.Next"
        app:srcCompat="@drawable/ic_arrow_forward" />
</LinearLayout>
