<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ll__place_collection_times"
    style="@style/PlacePageItemFrame"
    tools:background="#4000FFFF"
    tools:visibility="visible">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv__place_collection_times"
        style="@style/PlacePageMetadataIcon"
        android:layout_gravity="top"
        android:layout_marginTop="2dp"
        app:srcCompat="@drawable/ic_category_post" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv__place_collection_times"
            android:textAlignment="viewStart"
            style="@style/PlacePageMetadataText"
            android:text="@string/collection_times" />

        <LinearLayout
            android:id="@+id/ll__place_collection_times_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
