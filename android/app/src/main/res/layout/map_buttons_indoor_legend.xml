<?xml version="1.0" encoding="utf-8"?>
<!-- Debug overlay color legend shown when ?indoor mode is active -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/indoor_debug_legend"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  android:padding="6dp"
  android:background="#CC000000"
  android:visibility="gone">

  <!-- Level rows: color swatch + label (matches framework.cpp kLevelColors order) -->
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="1dp">
    <View android:layout_width="12dp" android:layout_height="12dp" android:background="#00B400" android:layout_marginEnd="4dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L0 ground" android:textColor="#FFFFFF" android:textSize="10sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="1dp">
    <View android:layout_width="12dp" android:layout_height="12dp" android:background="#0064FF" android:layout_marginEnd="4dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L1" android:textColor="#FFFFFF" android:textSize="10sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="1dp">
    <View android:layout_width="12dp" android:layout_height="12dp" android:background="#B400B4" android:layout_marginEnd="4dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L2" android:textColor="#FFFFFF" android:textSize="10sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="1dp">
    <View android:layout_width="12dp" android:layout_height="12dp" android:background="#DC7800" android:layout_marginEnd="4dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L3" android:textColor="#FFFFFF" android:textSize="10sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="1dp">
    <View android:layout_width="12dp" android:layout_height="12dp" android:background="#00B4B4" android:layout_marginEnd="4dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L4" android:textColor="#FFFFFF" android:textSize="10sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="1dp">
    <View android:layout_width="12dp" android:layout_height="12dp" android:background="#C8C800" android:layout_marginEnd="4dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L5" android:textColor="#FFFFFF" android:textSize="10sp"/>
  </LinearLayout>
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="3dp">
    <View android:layout_width="12dp" android:layout_height="12dp" android:background="#FF0050" android:layout_marginEnd="4dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="L6+" android:textColor="#FFFFFF" android:textSize="10sp"/>
  </LinearLayout>

  <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#66FFFFFF" android:layout_marginBottom="3dp"/>

  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="■ indoor polygon" android:textColor="#FFFFFF" android:textSize="9sp" android:paddingBottom="1dp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="○ level=* POI" android:textColor="#AAFFFFFF" android:textSize="9sp"/>

</LinearLayout>
