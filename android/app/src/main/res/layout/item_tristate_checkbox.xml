<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout style="@style/MwmWidget.Editor.MetadataBlock"
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <com.google.android.material.imageview.ShapeableImageView
  android:id="@+id/icon"
  style="@style/MwmWidget.Editor.MetadataIcon"
  android:layout_width="30dp"
  android:layout_height="30dp"
  tools:srcCompat="@drawable/ic_question_mark" />

  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/title"
    style="@style/MwmWidget.Editor.FieldLayout.EditText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_centerVertical="true"
    android:layout_marginStart="@dimen/editor_margin_left"
    android:layout_toStartOf="@+id/button_container"
    tools:text="Example"/>

  <app.organicmaps.widget.TriStateButtonView
  android:id="@+id/button_container"
  style="@style/Widget.Material3.MaterialButtonToggleGroup"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:layout_centerVertical="true"
  android:layout_alignParentEnd="true" />
</RelativeLayout>

