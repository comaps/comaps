			<string>lld</string>
			<key>zero</key>
			<string>ஏதுமில்லை.</string>
			<key>one</key>
			<string>%lld கோப்பு கண்டறியப்பட்டது. மாற்றியபின் பார்க்கலாம்.</string>
			<key>other</key>
			<string>%lld கோப்பு கண்டறியப்பட்டன. மாற்றியபின் பார்க்கலாம்.</string>
		</dict>
