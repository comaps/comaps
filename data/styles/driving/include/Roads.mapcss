/*
 * Keep here changes of the base default map style files only
 * (see main.mapcss for exact processing order).
 */

/* Escape lanes: from z14 in driving mode (default starts at z15) */
line|z14[highway=escape],
{color: @escape; opacity: 1; width: 2; dashes: 1.5,1.3;}
line|z14[highway=escape]::border,
{color: @minor_road_border; opacity: 0.1; width: 3; dashes: 1.5,1.3;}
