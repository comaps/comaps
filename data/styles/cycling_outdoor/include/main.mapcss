/*
 * Cycling Outdoor style is based on the default style
 * with added Cycling and Outdoor styles changes.
 * So first it includes default style files,
 * then - when corresponding change files exist - Cycling and Outdoor.
 * And optionally could include its own change files (none at the moment).
 */

@import("../../default/include/Basemap.mapcss");
@import("../../cycling/include/Basemap.mapcss");
@import("../../outdoors/include/Basemap.mapcss");

@import("../../default/include/Basemap_label.mapcss");
@import("../../outdoors/include/Basemap_label.mapcss");

@import("../../default/include/Roads.mapcss");
@import("../../cycling/include/Roads.mapcss");
@import("../../outdoors/include/Roads.mapcss");

@import("../../default/include/Roads_label.mapcss");
@import("../../outdoors/include/Roads_label.mapcss");

@import("../../default/include/Icons.mapcss");
/* TODO: temporary include walking changes with Fuel stations visibility reduction;
   move this change to the default style once Modes are released on Android */
@import("../../walking/include/Icons.mapcss");
@import("../../outdoors/include/Icons.mapcss");

@import("../../default/include/Icons_Label_Colors.mapcss");

@import("../../default/include/Subways.mapcss");
